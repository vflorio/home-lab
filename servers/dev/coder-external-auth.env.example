# Lets Coder workspaces clone/push to Gitea with the user's own token, no SSH keys to copy.
# Copy to coder-external-auth.env after creating the OAuth app in Gitea (see README)
CODER_EXTERNAL_AUTH_0_ID=gitea
CODER_EXTERNAL_AUTH_0_TYPE=gitea
CODER_EXTERNAL_AUTH_0_DISPLAY_NAME=Gitea
CODER_EXTERNAL_AUTH_0_CLIENT_ID=
CODER_EXTERNAL_AUTH_0_CLIENT_SECRET=
CODER_EXTERNAL_AUTH_0_AUTH_URL=https://git.dev.intranet.vflorio.com/login/oauth/authorize
CODER_EXTERNAL_AUTH_0_TOKEN_URL=https://git.dev.intranet.vflorio.com/login/oauth/access_token
CODER_EXTERNAL_AUTH_0_VALIDATE_URL=https://git.dev.intranet.vflorio.com/login/oauth/userinfo
CODER_EXTERNAL_AUTH_0_REGEX=git\.dev\.intranet\.vflorio\.com
