 
# Docker Compose 
COMPOSE_PROJECT_NAME=dev
COMPOSE_BAKE=true

 # Network 
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=192.168.1.0/24 # Needed for VPN access to local network
LOCAL_DOCKER_IP=192.168.1.193
INTRANET_GATEWAY_IP=192.168.1.190
INTRANET_NAS_IP=192.168.1.151
INTRANET_DOMAIN=dev.intranet.vflorio.com
GATEWAY_INTRANET_DOMAIN=gateway.intranet.vflorio.com # Authentik lives there

# Folders 
PATH_DATA=/mnt/nfs/ssd-0/homelab-data/dev

# User settings
PUID=1000
PGID=1000
UMASK=0002
TIMEZONE=Europe/Rome

# Docker Group ID for Coder permissions
DOCKER_GROUP=988


# Valkey
VALKEY_TRAEFIK_KOP=1

# App Ports
PORT_PORTAINER_AGENT=9001
PORT_VALKEY=6379

PORT_CODER=7080
PORT_GITEA_SSH=2222
PORT_GITEA=3000
PORT_REGISTRY=5000
PORT_VERDACCIO=4873
PORT_EXCALIDRAW=8043
PORT_DRAWIO=8084

# PostgreSQL Database
CODER_DATABASE=dev-coder
GITEA_DATABASE=dev-gitea
POSTGRES_PASSWORD=
POSTGRES_USER=dev-postgresql


# Verdaccio NPM Registry
VERDACCIO_USER=admin
VERDACCIO_PASSWORD=

# Authentik OIDC clients, same values as servers/gateway/.env: openssl rand -hex 32
CODER_OIDC_CLIENT_SECRET=
GITEA_OIDC_CLIENT_SECRET=
