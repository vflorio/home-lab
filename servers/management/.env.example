 
# Docker Compose 
COMPOSE_PROJECT_NAME=management
COMPOSE_BAKE=true

 # Network 
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=192.168.1.0/24 # Needed for VPN access to local network
LOCAL_DOCKER_IP=192.168.1.191
INTRANET_GATEWAY_IP=192.168.1.190
INTRANET_NAS_IP=192.168.1.151
INTRANET_DOMAIN=management.intranet.vflorio.com

# Folders 
PATH_DATA=/mnt/nfs/ssd-0/homelab-data/management

# User settings
PUID=1000
PGID=1000
UMASK=0002
TIMEZONE=Europe/Rome


# Postgres
POSTGRES_USER=management-postgresql
POSTGRES_PASSWORD=

# Authentik
AUTHENTIK_DATABASE=management-authentik

# Guacamole
GUACAMOLE_DATABASE=management-guacamole

# Semaphore
SEMAPHORE_DATABASE=management-semaphore
SEMAPHORE_ACCESS_KEY= # 32 bytes: openssl rand -base64 32
SEMAPHORE_ADMIN_USER=admin
SEMAPHORE_ADMIN_EMAIL=admin@vflorio.com
SEMAPHORE_ADMIN_PASSWORD=

# Valkey
VALKEY_TRAEFIK_KOP=1

# Ports
PORT_PORTAINER_AGENT=9001
PORT_POSTGRES=5432
PORT_VALKEY=6379
PORT_NETDATA=19999
PORT_GRAFANA=3800
PORT_GUACAMOLE=9200
PORT_GUACD=4822
PORT_HOMEPAGE=3100
PORT_PROMETHEUS=9090
PORT_PORTAINER=9000
PORT_SEMAPHORE=3001




 
