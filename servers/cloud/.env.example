 
# Docker Compose 
COMPOSE_PROJECT_NAME=cloud
COMPOSE_BAKE=true

 # Network 
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=192.168.1.0/24 # Needed for VPN access to local network
LOCAL_DOCKER_IP=192.168.1.194
INTRANET_GATEWAY_IP=192.168.1.190
INTRANET_NAS_IP=192.168.1.151
INTRANET_DOMAIN=cloud.intranet.vflorio.com
GATEWAY_INTRANET_DOMAIN=gateway.intranet.vflorio.com # Authentik lives there

# Folders 
PATH_DATA=/mnt/nfs/ssd-0/homelab-data/cloud
PATH_MEDIA=/mnt/nfs/ssd-0/photos

# User settings
PUID=1000
PGID=1000
UMASK=0002
TIMEZONE=Europe/Rome


# Valkey
VALKEY_TRAEFIK_KOP=1

# NextCloud
NEXTCLOUD_DATABASE=cloud_nextcloud
NEXTCLOUD_ADMIN_USER=vflorio
NEXTCLOUD_ADMIN_PASSWORD=
# Authentik OIDC client, same value as servers/gateway/.env: openssl rand -hex 32
NEXTCLOUD_OIDC_CLIENT_SECRET=

# Immich
IMMICH_DATABASE=cloud_immich
ONLYOFFICE_JWT_SECRET=

# Postgres
POSTGRES_USER=cloud_postgresql
POSTGRES_PASSWORD=

# App Ports
PORT_PORTAINER_AGENT=9001
PORT_NODE_EXPORTER=9100
PORT_CADVISOR=8180
PORT_POSTGRES=5432
PORT_VALKEY=6379
PORT_IMMICH=2283
PORT_NEXTCLOUD=8080
PORT_ONLYOFFICE=8081
