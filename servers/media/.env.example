 
# Docker Compose 
COMPOSE_PROJECT_NAME=media
COMPOSE_BAKE=true

 # Network 
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=192.168.1.0/24 # Needed for VPN access to local network
LOCAL_DOCKER_IP=192.168.1.192
INTRANET_GATEWAY_IP=192.168.1.190
INTRANET_NAS_IP=192.168.1.151
INTRANET_DOMAIN=media.intranet.vflorio.com

# Folders 
PATH_DATA=/mnt/nfs/ssd-0/homelab-data/media
PATH_MEDIA=/mnt/nfs/
PATH_MEDIA_RELAX=/mnt/nfs/ssd-0/relax

# User settings
PUID=1000
PGID=1000
UMASK=0002
TIMEZONE=Europe/Rome


# Valkey
VALKEY_TRAEFIK_KOP=1

# Ports
PORT_PORTAINER_AGENT=9001
PORT_VALKEY=6379

PORT_BAZARR=6767
PORT_FLARESOLVERR=8191
PORT_HOMEPAGE=3000
PORT_JELLYFIN=8096
PORT_EMBY=8097
PORT_JELLYSEERR=5055
PORT_LIDARR=8686
PORT_PROWLARR=9696
PORT_QBITTORRENT=8200
PORT_TDARR=8266
PORT_TDARR_WEB=8265
PORT_RADARR=7878
PORT_SABNZBD=8100
PORT_SONARR=8989
PORT_UNPACKERR_METRICS=5656

TP_THEME=nord
