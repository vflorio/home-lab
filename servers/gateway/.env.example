 
# Docker Compose 
COMPOSE_PROJECT_NAME=gateway
COMPOSE_BAKE=true

 # Network 
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=192.168.1.0/24 # Advertised to the tailnet by the Tailscale subnet router
LOCAL_DOCKER_IP=192.168.1.190 # Every published port binds only here (no public IPv6)
INTRANET_GATEWAY_IP=192.168.1.190
INTRANET_NAS_IP=192.168.1.151
INTRANET_DOMAIN=gateway.intranet.vflorio.com

# Folders 
PATH_DATA=/mnt/nfs/ssd-0/homelab-data/gateway

# User settings
PUID=1000
PGID=1000
UMASK=0002
TIMEZONE=Europe/Rome

# Cloudflare
CF_DNS_API_TOKEN=
CF_EMAIL=floriovincenzo98@gmail.com

# Postgres
POSTGRES_USER=gateway-postgresql
POSTGRES_PASSWORD=

# Valkey
VALKEY_TRAEFIK_KOP=1

# CrowdSec - Traefik bouncer key, any random string: openssl rand -base64 32
CROWDSEC_BOUNCER_KEY=

# Tailscale - reusable, pre-approved auth key tagged tag:homelab
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Authentik
AUTHENTIK_SECRET_KEY= # openssl rand -base64 60 | tr -d '\n')
AUTHENTIK_VERSION=2025.8.4
AUTHENTIK_ERROR_REPORTING__ENABLED=true
AUTHENTIK_DATABASE=gateway-authentik

# Authentik OIDC clients for the dev server apps (dev-oidc blueprint)
# Same values as servers/dev/.env: openssl rand -hex 32
DEV_INTRANET_DOMAIN=dev.intranet.vflorio.com
CODER_OIDC_CLIENT_SECRET=
GITEA_OIDC_CLIENT_SECRET=

# Authentik OIDC clients for the management server apps (management-oidc blueprint)
# Same values as servers/management/.env, Portainer's goes in its UI: openssl rand -hex 32
MANAGEMENT_INTRANET_DOMAIN=management.intranet.vflorio.com
GRAFANA_OIDC_CLIENT_SECRET=
PORTAINER_OIDC_CLIENT_SECRET=
SEMAPHORE_OIDC_CLIENT_SECRET=
VAULTWARDEN_OIDC_CLIENT_SECRET=

# Authentik OIDC clients for the cloud server apps (cloud-oidc blueprint)
# Nextcloud's is the same value as servers/cloud/.env, Immich's goes in its UI: openssl rand -hex 32
CLOUD_INTRANET_DOMAIN=cloud.intranet.vflorio.com
NEXTCLOUD_OIDC_CLIENT_SECRET=
IMMICH_OIDC_CLIENT_SECRET=

# Authentik Email / SMTP Settings

# SMTP Host Emails are sent to
EMAIL_SERVER_HOST=mail.vflorio.com
EMAIL_SERVER_PORT=25
# Optionally authenticate (don't add quotation marks to your password)
EMAIL_ADDRESS=email.address@vflorio.com
EMAIL_PASSWORD=
EMAIL_TLS=true # Use StartTLS
EMAIL_SSL=false # Use SSL - StartTLS and SSL can't both be true
EMAIL_SENDER=authentik@vflorio.com # Email address authentik will send from, should have a correct @domain.name

# Ports 

PORT_REVERSE_PROXY_HTTP=80
PORT_REVERSE_PROXY_HTTPS=443

PORT_TRAEFIK_METRICS=8082
PORT_CROWDSEC_METRICS=6060

PORT_AUTHENTIK=6080
PORT_PORTAINER_AGENT=9001
PORT_POSTGRES=5432
PORT_VALKEY=6379
